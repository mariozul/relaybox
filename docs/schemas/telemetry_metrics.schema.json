{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://schemas.agent-orchestration.internal/telemetry_metrics.schema.json",
  "title": "PipelineTelemetryMetrics",
  "description": "Canonical schema for runtime performance, latency, and token cost telemetry emitted by the Orchestrator Engine",
  "type": "object",
  "required": ["pipeline_status", "total_duration_seconds", "stage_latencies", "reviewer_verdict"],
  "properties": {
    "pipeline_status": {
      "type": "string",
      "enum": ["SUCCESS", "FAILED", "BLOCKED"]
    },
    "total_duration_seconds": {
      "type": "integer",
      "minimum": 0
    },
    "stage_latencies": {
      "type": "object",
      "required": ["planner_seconds", "coder_seconds", "reviewer_seconds", "closer_seconds"],
      "properties": {
        "planner_seconds": { "type": "integer" },
        "coder_seconds": { "type": "integer" },
        "reviewer_seconds": { "type": "integer" },
        "closer_seconds": { "type": "integer" }
      }
    },
    "token_telemetry": {
      "type": "object",
      "properties": {
        "input_tokens": { "type": "integer" },
        "output_tokens": { "type": "integer" },
        "total_tokens": { "type": "integer" },
        "cost_usd": { "type": ["string", "number"] }
      }
    },
    "reviewer_verdict": {
      "type": "string",
      "enum": ["APPROVED", "REJECTED", "NEEDS_FIX"]
    },
    "findings_count": {
      "type": "integer",
      "minimum": 0
    },
    "remediation_cycles": {
      "type": "integer",
      "minimum": 0,
      "description": "Number of automated remediation retry cycles executed"
    },
    "actual_loc_synthesized": {
      "type": "integer",
      "minimum": 0,
      "description": "Total lines of code added or modified in the workspace"
    },
    "gate_b_traceability": {
      "type": "string",
      "enum": ["PASS", "FAILED"]
    }
  }
}
