{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://schemas.agent-orchestration.internal/review_findings.schema.json",
  "title": "ReviewFindingsPayload",
  "description": "Canonical schema for code review findings and PR review comment triage emitted by the Reviewer Agent",
  "type": "object",
  "required": ["source", "impact_scope", "status", "findings"],
  "properties": {
    "source": {
      "type": "string",
      "enum": ["pre_pr_gate", "github_pr_review", "ci_failure"],
      "default": "github_pr_review"
    },
    "pr_number": {
      "type": ["integer", "string"],
      "description": "Pull Request number or identifier"
    },
    "impact_scope": {
      "type": "string",
      "enum": ["TACTICAL", "ARCH_PIVOT"],
      "default": "TACTICAL"
    },
    "status": {
      "type": "string",
      "enum": ["APPROVED", "NEEDS_FIX", "REJECTED"]
    },
    "summary": {
      "type": "string",
      "description": "Overall summary of the review or triage assessment"
    },
    "findings": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/ReviewFinding"
      }
    },
    "comments_ledger": {
      "type": "array",
      "description": "Ledger of PR review comments with action types and suggested replies",
      "items": {
        "$ref": "#/definitions/CommentLedgerEntry"
      }
    }
  },
  "definitions": {
    "ReviewFinding": {
      "type": "object",
      "required": ["id", "file_path", "line_start", "severity", "rule_violated", "description"],
      "properties": {
        "id": {
          "type": "string",
          "example": "F-001"
        },
        "file_path": {
          "type": "string",
          "example": "pkg/domain/wallet.go"
        },
        "line_start": {
          "type": "integer"
        },
        "line_end": {
          "type": "integer"
        },
        "severity": {
          "type": "string",
          "enum": ["P0", "P1", "P2", "P3", "CRITICAL", "HIGH", "MEDIUM", "LOW"]
        },
        "category": {
          "type": "string"
        },
        "rule_violated": {
          "type": "string",
          "example": "RULE-RES-01"
        },
        "description": {
          "type": "string"
        }
      }
    },
    "CommentLedgerEntry": {
      "type": "object",
      "required": ["comment_id", "action_type", "suggested_reply"],
      "properties": {
        "comment_id": {
          "type": "string",
          "example": "C-001"
        },
        "action_type": {
          "type": "string",
          "enum": ["ACTIONABLE_CODE_CHANGE", "EXPLANATION_ONLY", "OUT_OF_SCOPE"]
        },
        "target_file": {
          "type": "string",
          "example": "pkg/domain/wallet.go"
        },
        "line": {
          "type": "integer",
          "example": 42
        },
        "rule_violated": {
          "type": "string"
        },
        "description_for_coder": {
          "type": "string"
        },
        "suggested_reply": {
          "type": "string",
          "description": "Professional, context-aware reply to be posted to the reviewer on GitHub"
        }
      }
    }
  }
}
